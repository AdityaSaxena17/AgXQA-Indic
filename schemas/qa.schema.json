{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "language",
    "split",
    "source_document_id",
    "context",
    "question",
    "answers"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "en",
        "hi",
        "mr",
        "bn",
        "ta"
      ]
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    },
    "source_document_id": {
      "type": "string",
      "minLength": 1
    },
    "context": {
      "type": "string",
      "minLength": 1
    },
    "question": {
      "type": "string",
      "minLength": 1
    },
    "answers": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "text",
          "answer_start"
        ],
        "properties": {
          "text": {
            "type": "string",
            "minLength": 1
          },
          "answer_start": {
            "type": "integer",
            "minimum": 0
          }
        }
      }
    }
  }
}
