{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "document_id",
    "language",
    "text",
    "source_url",
    "license",
    "split"
  ],
  "properties": {
    "document_id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "hi",
        "mr",
        "bn",
        "ta"
      ]
    },
    "text": {
      "type": "string",
      "minLength": 1
    },
    "source_url": {
      "type": "string",
      "minLength": 1
    },
    "license": {
      "type": "string",
      "minLength": 1
    },
    "split": {
      "enum": [
        "train",
        "validation",
        "test"
      ]
    }
  }
}
