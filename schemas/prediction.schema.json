{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": [
    "id",
    "language",
    "prediction_text"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "language": {
      "enum": [
        "en",
        "hi",
        "mr",
        "bn",
        "ta"
      ]
    },
    "prediction_text": {
      "type": "string"
    }
  }
}
